model applications {
  id                     String             @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  user_id                String             @db.Uuid
  application_type       application_type
  name                   String
  email                  String
  school                 String
  note                   String?
  artist_type            String?
  genres                 String?
  streaming_links        String?
  photo_url              String?
  current_needs          String?
  upcoming_show          String?
  influences             String?
  industry_role          String?
  favorite_artists       String?
  instrument             String?
  favorite_genres        String?
  created_at             DateTime?          @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  updated_at             DateTime?          @db.Timestamptz(6)
  reviewed_at            DateTime?          @db.Timestamptz(6)
  reviewed_by            String?            @db.Uuid
  status_history         Json[]             @default([])
  modification_requests  String[]
  current_revision       Int?               @default(1)
  last_modified_at       DateTime?          @db.Timestamptz(6)
  last_modified_by       String?            @db.Uuid
  status                 application_status @default(pending)
  admin_approved_profile Json?
  finalized_at           DateTime?          @db.Timestamptz(6)
  finalized_by           String?            @db.Uuid
  user_accepted_at       DateTime?          @db.Timestamptz(6)
  bio                    String?
  social_links           Json?
  specific_connections   String?
  phone_number           String?
  location               String?
  years_experience       Int?
  rate                   String?
  equipment              String?
  company                String?
  phone                  String?
  profiles               profiles[]

  @@index([application_type], map: "idx_applications_type")
  @@index([user_id], map: "idx_applications_user_id")
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
